%%
% Violin / Distribution plots for Base_mean and Base_peak
% Using ksdensity-based violins since you may not have the violin toolbox
%%
function plot_violins(allTables2, outcome_var, title_str)
    % Define grouping variables and their labels
    groupings = {
        'PrePost',   {'Pre','Track','Post'},   [1 2 3];
        'EarlyLate', {'Early','Late'}, [1 2];
    };

    n_groups = size(groupings, 1);
    colors = {[0.4 0.6 0.8], [0.9 0.4 0.3], [0.4 0.8 0.5], [0.8 0.6 0.2]};

    figure('Position', [100 100 1400 500]);
    sgtitle(title_str, 'FontSize', 16);

    for g = 1:n_groups
        subplot(1, n_groups, g);
        hold on;

        var_name   = groupings{g, 1};
        grp_labels = groupings{g, 2};
        grp_vals   = groupings{g, 3};

        y     = allTables2.(outcome_var);
        valid = ~isnan(y);

        x_positions = 1:length(grp_labels);

        % Collect group data for stats
        grp_data_all = cell(length(grp_labels), 1);

        for k = 1:length(grp_vals)
            % Get mask for this group
            if iscategorical(allTables2.(var_name))
                if iscell(grp_vals)
                    mask = allTables2.(var_name) == grp_vals{k} & valid;
                else
                    mask = allTables2.(var_name) == string(grp_vals(k)) & valid;
                end
            else
                mask = allTables2.(var_name) == grp_vals(k) & valid;
            end

            grp_data = y(mask);
            grp_data = grp_data(~isnan(grp_data));
            grp_data_all{k} = grp_data;

            if length(grp_data) < 10
                continue
            end

            xpos = x_positions(k);
            col  = colors{k};

            % KDE violin
            [f, xi] = ksdensity(grp_data, 'NumPoints', 100);

            % Clip to 1st-99th percentile
            in_range = xi >= prctile(grp_data, 1) & xi <= prctile(grp_data, 99);
            f  = f(in_range);
            xi = xi(in_range);

            % Normalize width
            f = f / max(f) * 0.35;

            % Draw violin — no box
            fill([xpos + f, xpos - fliplr(f)], ...
                 [xi,        fliplr(xi)], ...
                 col, 'FaceAlpha', 0.5, 'EdgeColor', 'none');

            % Median line only
            med = median(grp_data);
            plot([xpos - 0.15, xpos + 0.15], [med med], ...
                 'k-', 'LineWidth', 2.5);
           

            % Add median value as text
            text(xpos + 0.2, med, sprintf('%.4f', med), ...
            'VerticalAlignment', 'middle', 'FontSize', 9, 'Color', 'k'); 
            
            % Jittered points
            n_pts = min(length(grp_data), 300);
            idx_s = randperm(length(grp_data), n_pts);
            jitter = (rand(n_pts, 1) - 0.5) * 0.1;
            scatter(xpos + jitter, grp_data(idx_s), ...
                8, 'k', 'filled', 'MarkerFaceAlpha', 0.15);

            % n label
            text(xpos, min(xi) - range(xi)*0.05, ...
                 sprintf('n=%d', length(grp_data)), ...
                 'HorizontalAlignment', 'center', 'FontSize', 9);
        end

        %% Significance bars between all pairs
        % collect y max for bracket placement
        y_vals = y(valid);
        y_top  = prctile(y_vals, 99);
        y_range = range(y_vals(y_vals >= prctile(y_vals,1) & y_vals <= prctile(y_vals,99)));
        bracket_step = y_range * 0.08;
        bracket_y    = y_top + bracket_step;

        pairs = nchoosek(1:length(grp_labels), 2); % all pairwise combos

       for p = 1:size(pairs, 1)
            i1 = pairs(p, 1);
            i2 = pairs(p, 2);

            d1 = grp_data_all{i1};
            d2 = grp_data_all{i2};

            if length(d1) < 5 || length(d2) < 5
                continue
            end

            % Wilcoxon rank-sum + effect size
            [p_val, ~, stats_rs] = ranksum(d1, d2, 'method', 'approximate');
            n1 = length(d1);
            n2 = length(d2);
            r_effect = 1 - (2 * stats_rs.ranksum) / (n1 * (n1 + n2 + 1));
            obs_diff = median(d1) - median(d2);
            stats_rs
            p_val
            % Bootstrap 95% CI on median difference
            n_boot   = 500;
            boot_diff = zeros(n_boot, 1);
            for b = 1:n_boot
                s1 = d1(randi(n1, n1, 1));
                s2 = d2(randi(n2, n2, 1));
                boot_diff(b) = median(s1) - median(s2);
            end
            ci_lo = prctile(boot_diff, 2.5);
            ci_hi = prctile(boot_diff, 97.5);

            % Print full stats to console
            fprintf('\n[%s] %s vs %s:\n', var_name, grp_labels{i1}, grp_labels{i2});
            fprintf('  Median %s = %.5f, Median %s = %.5f\n', ...
                grp_labels{i1}, median(d1), grp_labels{i2}, median(d2));
            fprintf('  Mean %s = %.5f, Mean %s = %.5f\n', ...
                grp_labels{i1}, mean(d1), grp_labels{i2}, mean(d2));
            fprintf('  SD %s = %.5f, SD %s = %.5f\n', ...
                grp_labels{i1}, std(d1), grp_labels{i2}, std(d2));
            fprintf('  Delta median = %.5f [95%% CI: %.5f, %.5f]\n', obs_diff, ci_lo, ci_hi);
            fprintf('  Ranksum p = %.4f, effect size r = %.3f\n', p_val, r_effect);

            % Significance label
            if p_val < 0.001
                sig_str = '***';
            elseif p_val < 0.01
                sig_str = '**';
            elseif p_val < 0.05
                sig_str = '*';
            else
                sig_str = 'ns';
            end

            % Draw bracket
            x1 = x_positions(i1);
            x2 = x_positions(i2);
            tick_h = bracket_step * 0.3;

            plot([x1, x1, x2, x2], ...
                 [bracket_y - tick_h, bracket_y, bracket_y, bracket_y - tick_h], ...
                 'k-', 'LineWidth', 1);
            text((x1 + x2)/2, bracket_y + tick_h * 0.5, sig_str, ...
                 'HorizontalAlignment', 'center', 'FontSize', 11);

            % Add effect size below sig star on plot
            text((x1 + x2)/2, bracket_y + tick_h * 2, ...
                 sprintf('r=%.2f', r_effect), ...
                 'HorizontalAlignment', 'center', 'FontSize', 8, ...
                 'Color', [0.4 0.4 0.4]);

            bracket_y = bracket_y + bracket_step * 1.8;
       end

        % Reference line at 0
        yline(0, 'k--', 'LineWidth', 1);

        % Axes
        xticks(x_positions);
        xticklabels(grp_labels);
        xlim([0.5, length(grp_labels) + 0.5]);
        ylabel(strrep(outcome_var, '_', ' '));
        title(var_name, 'Interpreter', 'none');
        set(gca, 'FontSize', 12);
        box off;
    end

    set(gcf, 'renderer', 'painters');
    ylim([-5 6])
    %% Print summary stats per group
    fprintf('\n=== %s: %s ===\n', var_name, outcome_var);
    fprintf('%-12s %10s %10s %10s %10s\n', 'Group', 'Median', 'Mean', 'IQR_lo', 'IQR_hi');
    for k = 1:length(grp_vals)
        d = grp_data_all{k};
        if isempty(d)
            continue; 
        end
        fprintf('%-12s %10.5f %10.5f %10.5f %10.5f\n', ...
        grp_labels{k}, ...
        median(d), ...
        mean(d), ...
        prctile(d, 25), ...
        prctile(d, 75));
    end
end

% %% Accumulator function (on the fly, no big matrix)
% function [grand_mean, grand_sd, n_events, mean_mean] = compute_peth(allTables2, mask, n_samples)
%     n_acc    = zeros(1, n_samples);
%     sum_acc  = zeros(1, n_samples);
%     sum2_acc = zeros(1, n_samples);
%     mean_mean = [];
%     idx = find(mask);
%     for i = 1:length(idx)
%         row = idx(i);
%         if allTables2.PrePost(row) == '1'
%             sig = single(allTables2.TwosPreProc{row}.signal(:)')-allTables2.PreSWRmean(row);   % single precision
%             mean_mean = [mean_mean; allTables2.PreSWRmean(i)];
%         elseif allTables2.PrePost(row) == '2'
%             sig = single(allTables2.TwosTrackProc{row}.signal(:)')-allTables2.PreSWRmean(row);  % single precision
%             mean_mean = [mean_mean; allTables2.PreSWRmean(i)];
%         elseif allTables2.PrePost(row) == '3'
%             sig = single(allTables2.TwosPostProc{row}.signal(:)')-allTables2.PreSWRmean(row);  % single precision
%             mean_mean = [mean_mean; allTables2.PreSWRmean(i)];
%         else
%             continue
%         end
%         if length(sig) == n_samples
%             valid         = ~isnan(sig);
%             n_acc         = n_acc    + valid;
%             sum_acc       = sum_acc  + sig;
%             sum2_acc      = sum2_acc + sig.^2;
%         end
%     end
% 
%     grand_mean = sum_acc ./ n_acc;
%     grand_sd   = sqrt((sum2_acc - (sum_acc.^2) ./ n_acc) ./ (n_acc - 1));
%     n_events   = max(n_acc);
%     mean_mean = mean(mean_mean); 
% end

%% ~~~ FUNCTIONS ~~~

%% Accumulator function with circular shuffling
function [grand_mean, grand_sd, n_events, mean_mean] = ...
    compute_peth(allTables2, mask, n_samples)

n_acc    = zeros(1, n_samples);
sum_acc  = zeros(1, n_samples);
sum2_acc = zeros(1, n_samples);

mean_mean = [];
idx = find(mask);
n_used = 0;

for i = 1:length(idx)
    row = idx(i);

    % Get signal
    if allTables2.PrePost(row) == '1'
        sig = single(allTables2.TwosPreProc{row}.signal(:)');
    elseif allTables2.PrePost(row) == '2'
        sig = single(allTables2.TwosTrackProc{row}.signal(:)');
    elseif allTables2.PrePost(row) == '3'
        sig = single(allTables2.TwosPostProc{row}.signal(:)');
    else
        continue
    end
    % Check signal length
    if length(sig) ~= n_samples
        continue
    end

    % ---------------------------------------------------------
    % Random circular shift: -2 to +2 seconds
    % ---------------------------------------------------------
    % shift_sec = -1 + 1*rand;
    % shift_samples = round(shift_sec * fs);
    % sig = circshift(sig, shift_samples);

    % Baseline
    baseline = mean(sig(1:4800), 'omitnan');

    mean_mean = [mean_mean; baseline];

    % Baseline subtract
    sig = sig - baseline;
    valid = ~isnan(sig);
    % Set NaNs to zero BEFORE adding to accumulator
    sig(~valid) = 0;
    n_acc    = n_acc    + valid;
    sum_acc  = sum_acc  + sig;
    sum2_acc = sum2_acc + sig.^2;

    n_used = n_used + 1;
end

% Grand mean
grand_mean = NaN(1, n_samples);
grand_mean(n_acc > 0) = ...
    sum_acc(n_acc > 0) ./ n_acc(n_acc > 0);

% Grand SD
grand_sd = NaN(1, n_samples);
valid_n = n_acc > 1;
grand_sd(valid_n) = sqrt( ...
    (sum2_acc(valid_n) - ...
    (sum_acc(valid_n).^2 ./ n_acc(valid_n))) ./ ...
    (n_acc(valid_n) - 1));

% Number of events actually included
n_events = n_used;
mean_mean = mean(mean_mean, 'omitnan');
end


%% Speed compute PETH
function [grand_mean, grand_sd, n_events] = ...
    compute_peth_speed(allTables2, mask, n_samples)

n_acc    = zeros(1, n_samples);
sum_acc  = zeros(1, n_samples);
sum2_acc = zeros(1, n_samples);

idx = find(mask);
n_used = 0;

for i = 1:length(idx)

    row = idx(i);

    % Get signal
    if allTables2.PrePost(row) == '1'
        sig = single(allTables2.speed8s{row,1});
    elseif allTables2.PrePost(row) == '2'
        sig = single(allTables2.speed8s{row,1});
    elseif allTables2.PrePost(row) == '3'
        sig = single(allTables2.speed8s{row,1});

    else
        continue
    end

    valid = ~isnan(sig);
    sig(~valid) = 0;

    n_acc    = n_acc    + valid;
    sum_acc  = sum_acc  + sig;
    sum2_acc = sum2_acc + sig.^2;
    n_used = n_used + 1;
end
% Grand mean
grand_mean = NaN(1, n_samples);
grand_mean(n_acc > 0) = ...
    sum_acc(n_acc > 0) ./ n_acc(n_acc > 0);

% Grand SD
grand_sd = NaN(1, n_samples);
valid_n = n_acc > 1;
grand_sd(valid_n) = sqrt( ...
    (sum2_acc(valid_n) - ...
    (sum_acc(valid_n).^2 ./ n_acc(valid_n))) ./ ...
    (n_acc(valid_n) - 1));
% Number of events actually included
n_events = n_used;
%mean_mean = mean(mean_mean, 'omitnan');
end
%% FAST_JITTER_PETH WITH 1000 iterations
function [grand_jitter,jitter_sem,...
          null_mean,null_sd] = ...
          fast_jitter_peth(T,mask,n_samples,...
                           Fs,n_jitter,jitter_sec)
% Get mice
mice = unique(T.mouseID(mask));
n_mice = length(mice);
% Store one jittered mean for each mouse
mouse_jitter_mean = nan(n_mice,n_samples);
% Also store each complete jittered GRAND run
% This is used for the null distribution/z-score.
grand_jitter_runs = nan(n_jitter,n_samples);

% LOOP OVER MICE

for m = 1:n_mice
    mouse_mask = mask & T.mouseID == mice(m);
    rows = find(mouse_mask);
    n_events = length(rows);
    signals = nan(n_events,n_samples);
    for i = 1:n_events
        row = rows(i);
        if T.PrePost(row) == categorical(1)
            sig = T.TwosPreProc{row}.signal;
        elseif T.PrePost(row) == categorical(2)
            sig = T.TwosTrackProc{row}.signal;
        elseif T.PrePost(row) == categorical(3)
            sig = T.TwosPostProc{row}.signal;
        else
            continue
        end

        sig = double(sig(:)');
        if length(sig) == n_samples
            signals(i,:) = sig; % store signals for all events here
        end
    end

    % Remove bad events
    signals = signals(~all(isnan(signals),2),:);
    n_events = size(signals,1);

    if n_events == 0
        continue
    end

    % RUN 1000 JITTERS

    mouse_runs = nan(n_jitter,n_samples);
    for j = 1:n_jitter
        shifted = nan(n_events,n_samples);

        % Random shifts for ALL events
        shifts = round( ...
            (-jitter_sec + ...
            2*jitter_sec*rand(n_events,1))*Fs); 

        % Shift events and baseline them
        for i = 1:n_events
            shifted(i,:) = circshift(signals(i,:),shifts(i))- mean(signals(i,(1:4800)),'omitnan');
        end

       % Average events within mouse
        mouse_runs(j,:) = ...
            mean(shifted,1,'omitnan');
    end


    % Average 1000 jitter runs for this mouse
    mouse_jitter_mean(m,:) = ...
        mean(mouse_runs,1,'omitnan');

    % Save individual mouse runs for later
    if m == 1
        grand_jitter_runs = mouse_runs / n_mice;
    else
        grand_jitter_runs = ...
            grand_jitter_runs + mouse_runs / n_mice;
    end

end

% JITTERED GRAND TRACE

grand_jitter = ...
    mean(mouse_jitter_mean,1,'omitnan');


% SEM ACROSS MICE
jitter_sem = ...
    std(mouse_jitter_mean,0,1,'omitnan') ./ ...
    sqrt(sum(~isnan(mouse_jitter_mean),1));
% NULL DISTRIBUTION
null_mean = ...
    mean(grand_jitter_runs,1,'omitnan');
null_sd = ...
    std(grand_jitter_runs,0,1,'omitnan');
end


%% COMPUTE JITTER PETH
function jitter_mean = compute_jittered_peth(T, mask, n_samples, Fs)

    % Get rows for this group
    T_group = T(mask,:);
    n_events = height(T_group);
    jittered_signals = nan(n_events, n_samples);

    for i = 1:n_events
        % Get signal

        if T_group.PrePost(i) == '1'
            signal = T_group.TwosPreProc{i}.signal;

        elseif T_group.PrePost(i) == '2'
            signal = T_group.TwosTrackProc{i}.signal;

        elseif T_group.PrePost(i) == '3'
            signal = T_group.TwosPostProc{i}.signal;

        else
            continue
        end

        % Make sure signal is a row vector
        signal = signal(:)';

        % Random jitter between -1 and +1 seconds
        shift_sec = -1 + 2*rand;
        shift_samples = round(shift_sec * Fs);

        % Circularly shift
        signal_jittered = circshift(signal, shift_samples);

        % Store
        jittered_signals(i,:) = signal_jittered;
    end

    % Average across events
    jitter_mean = mean(jittered_signals, 1, 'omitnan');

end