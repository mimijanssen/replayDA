%% Wilcoxin Rank sum stat : 
% for each session . 

track_ses_idx = find(nonan_Tbl.prepost == '2');
track_ses_means = nonan_Tbl(track_ses_idx,:).mean; 

pre_ses_idx = find(nonan_Tbl.prepost == '1');
